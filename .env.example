# Copier vers .env : cp .env.example .env
# Utilisé par docker compose et les scripts scripts/smoke-test.sh

PROJECT_NAME=pfe-escape

# Ports exposés sur l'hôte (18080/18081 évite les conflits fréquents sur macOS avec 8080)
HUB_PORT=18080
PIVOT_PORT=18081
# SSH ops sur le pivot (voie shell / port-forward vers CCTV)
PIVOT_SSH_PORT=2222
# Workstation Kali — outils réels (API pour OMEGA Shell)
WORKSTATION_PORT=18083
